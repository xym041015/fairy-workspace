+  assert.equal(wavPcmData(wavBuffer()).length, 16);
+  assert.equal(wavPcmData(wavBuffer({ channels: 2 })), null);
+  assert.equal(wavPcmData(wavBuffer({ sampleRate: 44100 })), null);
+  assert.equal(wavPcmData(Buffer.from('not a wav')), null);
+});
