+  const voices = parseVoiceList(VOICE_LIST);
+  assert.deepEqual(voices.map((voice) => voice.locale), ['zh_CN', 'zh_TW', 'en_GB']);
+  assert.equal(selectVoice(voices), 'Tingting (中文（中国大陆）)');
+  assert.equal(selectVoice(voices, 'Meijia'), 'Meijia');
+});
